resource "azurerm_key_vault" "env" {
  name                       = "kv${local.flat}"
  location                   = var.location
  resource_group_name        = local.rg
  tenant_id                  = data.azurerm_client_config.current.tenant_id
  sku_name                   = "standard"
  rbac_authorization_enabled = true
  soft_delete_retention_days = local.is_prd ? 90 : 7
  # Prod secrets cannot be purged even by an owner until the retention window ends; stage keeps the
  # ability to purge so it can be torn down and rebuilt.
  purge_protection_enabled = local.is_prd
  tags                     = local.tags
}

# Terraform writes the generated secrets and the placeholders below, so the identity running this
# apply needs data-plane access to its own vault.
resource "azurerm_role_assignment" "deployer_kv" {
  scope                = azurerm_key_vault.env.id
  role_definition_name = "Key Vault Secrets Officer"
  principal_id         = data.azurerm_client_config.current.object_id
}

# Role assignments take a while to reach the Key Vault data plane; writing a secret straight after
# granting the role fails with 403 on a fresh vault.
resource "time_sleep" "kv_rbac" {
  depends_on      = [azurerm_role_assignment.deployer_kv]
  create_duration = "60s"
}

resource "random_password" "generated" {
  for_each = toset(values(var.api_generated_secrets))

  length  = 48
  special = false
}

resource "azurerm_key_vault_secret" "generated" {
  for_each = toset(values(var.api_generated_secrets))

  name         = each.value
  key_vault_id = azurerm_key_vault.env.id
  value        = random_password.generated[each.value].result
  content_type = "generated by terraform"

  depends_on = [time_sleep.kv_rbac]
}

resource "azurerm_key_vault_secret" "copied" {
  for_each = toset(values(var.api_copied_secrets))

  name         = each.value
  key_vault_id = azurerm_key_vault.env.id
  value        = "PLACEHOLDER"
  content_type = "set with: az keyvault secret set --vault-name ${azurerm_key_vault.env.name} --name ${each.value}"

  depends_on = [time_sleep.kv_rbac]

  lifecycle {
    # The real value is set out of band and must never be reverted to the placeholder.
    ignore_changes = [value, content_type]
  }
}
