# package_name goes first on purpose: an exception anywhere in this file aborts
# Appfile evaluation, silently dropping every value below it. That is exactly how
# a bogus json_key_data() call here produced "No value found for 'package_name'".
package_name("com.petroll.pet_roll")

# In CI the service account JSON arrives as SUPPLY_JSON_KEY_DATA, which supply
# reads directly from the environment — there is no json_key_data Appfile DSL
# method. Only fall back to a local key file when that env var is absent, since
# supply rejects json_key_file and json_key_data being set together.
if ENV['SUPPLY_JSON_KEY_DATA'].to_s.empty? && File.exist?("/tmp/play-publisher-key.json")
  json_key_file("/tmp/play-publisher-key.json")
end
